// Output of the "apriltag" pipeline: /<device_id>/pipelines/apriltag/output/camera_<i>
// NT type string: "dsv0_fb"
//
// The namespace stays "dsv0" because the robot's generated Java classes
// (package dsv0) come from it. Field order and types must not change without
// regenerating those classes; add new fields only at the end of a table.
namespace dsv0;

struct Vec3 {
  x: float64;
  y: float64;
  z: float64;
}

struct Quaternion {
  w: float64;
  x: float64;
  y: float64;
  z: float64;
}

/// WPILib coordinates (field frame: +X downfield, +Z up)
struct Pose3d {
  translation: Vec3;
  rotation: Quaternion;
}

table PoseSolution {
  /// Field-to-camera pose
  pose: Pose3d;
  /// solvePnP reprojection error, pixels
  error: float64;
}

table CameraObservation {
  /// Primary pose solution (always present)
  solution_0: PoseSolution;
  /// Alternate pose solution (only for single-tag observations, which are ambiguous)
  solution_1: PoseSolution;
  /// IDs of the tags used in this observation
  tag_ids: [int32];
}

// Timestamps are not in the message: the capture time is the NT value
// timestamp (TimestampedRaw.timestamp, robot clock, us). The old
// timestamp_us fields are deprecated, not deleted, so field slots (and the
// robot's existing generated classes) stay compatible.

table CameraOutput {
  timestamp_us: int64 (deprecated);
  /// Camera index within the multi-camera module
  camera_index: int32;
  /// Field-relative camera pose observation (null if no tags seen)
  camera_observation: CameraObservation;
  /// Pipeline frames per second (0 if not reported this cycle)
  fps: int32;
}

/// One message per camera per frame
table Frame {
  timestamp_us: int64 (deprecated);
  /// Per-camera results (one entry: this topic's camera)
  cameras: [CameraOutput];
}

root_type Frame;
