namespace dsv0;

struct Vec3 {
  x: float64;
  y: float64;
  z: float64;
}

struct Quaternion {
  w: float64;
  x: float64;
  y: float64;
  z: float64;
}

struct Pose3d {
  translation: Vec3;
  rotation: Quaternion;
}

table PoseSolution {
  pose: Pose3d;
  reprojection_error: float64;
}

table CameraObservation {
  /// Primary pose solution (always present)
  solution_0: PoseSolution (required);
  /// Alternate pose solution (present for single-tag ambiguity)
  solution_1: PoseSolution;
  /// IDs of the tags used in this observation
  tag_ids: [int32] (required);
}

/// Results from one camera; field-to-camera
table CameraOutput {
  /// Camera index within the multi-camera module
  camera_index: int32;
  /// Field-relative camera pose observation (null if no tags seen)
  camera_observation: CameraObservation;
  /// Frames per second (0 if not reported this cycle)
  fps: int32;
}

table PerCameraResults {
  // Length = # of cameras
  results: [CameraOutput] (required);
}

/// Combined camera results; field-to-robot
table CombinedResults {
  /// Field-relative robot pose observation (null if no tags seen)
  robot_observation: CameraObservation;
  /// Frames per second (0 if not reported this cycle)
  fps: int32;
}

union Results {
  PerCameraResults,
  CombinedResults
}

/// Top-level message containing results from all cameras in a single frame
table Frame {
  /// Either per-camera or combined results
  results: Results (required);
}

root_type Frame;
